                "${workspaceFolder}/install/**",
                "${workspaceFolder}/.deps/dqrobotics/include",
                "/home/franz/.local/mujoco-3.2.0/include",
                "/usr/include/x86_64-linux-gnu/qt5/QtWidgets",
